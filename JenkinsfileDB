node {
    stage('Preparation') {
        catchError(buildResult: 'SUCCESS') {
            sh 'docker stop samplerunning'
            sh 'docker rm samplerunning'
        }
    }
    stage('Change Database') {
        build 'changeDatabase'
    }
    stage('DBChangeResults') {
        build 'verifyDBChange'
    }
    stage('Build') {
        build '.NETAppBuild'
    }
    stage('Results') {
        build 'test.NETApplicationServer'
    }
}